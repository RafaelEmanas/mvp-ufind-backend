# ============================================================
# ufind-backend — production environment template
#
# Copy to .env.prod and fill in the real values:
#   cp .env.example .env.prod
# ============================================================

# ─────────────────────────────
# Database
# ─────────────────────────────
# URL format: jdbc:postgresql://<host>:<port>/<db_name>
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Postgres container configuration
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ─────────────────────────────
# JWT
# ─────────────────────────────
# Use a long random string. Example:
#   openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_COOKIE_NAME=token

# ─────────────────────────────
# Storage — Cloudflare R2
#
# Get these from: Cloudflare Dashboard → R2 → Manage API tokens
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
# ─────────────────────────────
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_REGION=auto